+import { createServer, type Server } from "node:http";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import type { AddressInfo } from "node:net";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { createWorkflowHubHooks } from "./workflow-hooks";
+
+const toolCall = { toolCallId: "call-1", toolName: "read_file" };
+
+function beforeToolContext() {
+	return { toolCall, input: { path: "README.md" } } as never;
+}
+
+describe("createWorkflowHubHooks", () => {
+	let server: Server | undefined;
+	let lastBody: unknown;
+	let respondWith: { status?: number; body?: unknown } = {};
+	let home: string;
+	let originalHome: string | undefined;
+	let bridgeUrl: string;
+
+	beforeEach(async () => {
+		lastBody = undefined;
+		respondWith = {};
+		originalHome = process.env.HOME;
+		home = mkdtempSync(join(tmpdir(), "workflow-hooks-home-"));
+		process.env.HOME = home;
+		server = createServer((request, response) => {
+			const chunks: Buffer[] = [];
+			request.on("data", (chunk) => chunks.push(chunk));
+			request.on("end", () => {
+				lastBody = JSON.parse(Buffer.concat(chunks).toString("utf8"));
+				if (request.headers.authorization !== "Bearer test-token") {
+					response.writeHead(401, { "content-type": "application/json" });
+					response.end(JSON.stringify({ error: "unauthorized" }));
+					return;
+				}
+				response.writeHead(respondWith.status ?? 200, {
+					"content-type": "application/json",
+				});
+				response.end(JSON.stringify(respondWith.body ?? {}));
+			});
+		});
+		await new Promise<void>((resolve) => server!.listen(0, "127.0.0.1", resolve));
+		const { port } = server.address() as AddressInfo;
+		bridgeUrl = `http://127.0.0.1:${port}`;
+		process.env.WORKFLOW_CLINE_BRIDGE_URL = bridgeUrl;
+		process.env.WORKFLOW_CLINE_BRIDGE_TOKEN = "test-token";
+	});
+
+	afterEach(async () => {
+		delete process.env.WORKFLOW_CLINE_BRIDGE_URL;
+		delete process.env.WORKFLOW_CLINE_BRIDGE_TOKEN;
+		if (originalHome === undefined) delete process.env.HOME;
+		else process.env.HOME = originalHome;
+		rmSync(home, { recursive: true, force: true });
+		await new Promise<void>((resolve) => server?.close(() => resolve()));
+		server = undefined;
+	});
+
+	it("allows the tool when the Workflow authority does not stop it", async () => {
+		const hooks = createWorkflowHubHooks();
+		const result = await hooks.beforeTool?.(beforeToolContext());
+		expect(result?.stop).toBeFalsy();
+		expect(lastBody).toEqual({
+			toolCall,
+			input: { path: "README.md" },
+			workspace: process.cwd(),
+		});
+	});
+
+	it("includes the run id in the authorization request when bound to a run", async () => {
+		const hooks = createWorkflowHubHooks("cron-1");
+		const result = await hooks.beforeTool?.(beforeToolContext());
+		expect(result?.stop).toBeFalsy();
+		expect(lastBody).toEqual({
+			toolCall,
+			input: { path: "README.md" },
+			workspace: process.cwd(),
+			runId: "cron-1",
+		});
+	});
+
+	it("propagates a stop decision from the Workflow authority", async () => {
+		respondWith = { body: { stop: true, reason: "denied by workflow" } };
+		const hooks = createWorkflowHubHooks();
+		const result = await hooks.beforeTool?.(beforeToolContext());
+		expect(result).toEqual({ stop: true, reason: "denied by workflow" });
+	});
+
+	it("fails closed when the authority rejects the request", async () => {
+		respondWith = { status: 500, body: { error: "authority exploded" } };
+		const hooks = createWorkflowHubHooks();
+		const result = await hooks.beforeTool?.(beforeToolContext());
+		expect(result?.stop).toBe(true);
+		expect(result?.reason).toContain("authority exploded");
+	});
+
+	it("fails closed when the authority is unreachable", async () => {
+		process.env.WORKFLOW_CLINE_BRIDGE_URL = "http://127.0.0.1:1";
+		const hooks = createWorkflowHubHooks();
+		const result = await hooks.beforeTool?.(beforeToolContext());
+		expect(result?.stop).toBe(true);
+		expect(result?.reason).toMatch(/unavailable/i);
+	});
+
+	it("fails closed when the bridge environment is not configured", async () => {
+		delete process.env.WORKFLOW_CLINE_BRIDGE_URL;
+		const hooks = createWorkflowHubHooks();
+		const result = await hooks.beforeTool?.(beforeToolContext());
+		expect(result?.stop).toBe(true);
+		expect(result?.reason).toMatch(/WORKFLOW_CLINE_BRIDGE/);
+	});
+
+	it("resolves the Workflow hub through its discovery file when the environment is absent", async () => {
+		delete process.env.WORKFLOW_CLINE_BRIDGE_URL;
+		delete process.env.WORKFLOW_CLINE_BRIDGE_TOKEN;
+		const discoveryDir = join(home, ".workflow", "hub");
+		mkdirSync(discoveryDir, { recursive: true });
+		writeFileSync(
+			join(discoveryDir, "discovery.json"),
+			JSON.stringify({ hubId: "hub-1", endpoint: bridgeUrl, token: "test-token" }),
+		);
+
+		const hooks = createWorkflowHubHooks();
+		const result = await hooks.beforeTool?.(beforeToolContext());
+		expect(result?.stop).toBeFalsy();
+		expect(lastBody).toEqual({
+			toolCall,
+			input: { path: "README.md" },
+			workspace: process.cwd(),
+		});
+	});
+
+	it("fails closed when the discovery file is stale", async () => {
+		delete process.env.WORKFLOW_CLINE_BRIDGE_URL;
+		delete process.env.WORKFLOW_CLINE_BRIDGE_TOKEN;
+		const discoveryDir = join(home, ".workflow", "hub");
+		mkdirSync(discoveryDir, { recursive: true });
+		writeFileSync(
+			join(discoveryDir, "discovery.json"),
+			JSON.stringify({ hubId: "stale", endpoint: "http://127.0.0.1:1", token: "test-token" }),
+		);
+
+		const hooks = createWorkflowHubHooks();
+		const result = await hooks.beforeTool?.(beforeToolContext());
+		expect(result?.stop).toBe(true);
+		expect(result?.reason).toMatch(/unavailable/i);
+	});
+});
diff --git a/sdk/packages/core/src/hub/daemon/workflow-hooks.ts b/sdk/packages/core/src/hub/daemon/workflow-hooks.ts
new file mode 100644
index 0000000..6aba2f6
--- /dev/null
+++ b/sdk/packages/core/src/hub/daemon/workflow-hooks.ts
@@ -0,0 +1,92 @@
+import { readFileSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+import type { AgentHooks } from "@cline/shared";
+
+type BridgeResponse = {
+	stop?: boolean;
+	reason?: string;
+	error?: string;
+};
+
+type BridgeAuthority = { url: string; token: string };
+
+/**
+ * Resolves the Workflow authority per hook call: launcher-provided
+ * environment first, then the global hub's discovery file. Per-call
+ * resolution keeps detached daemons working across hub restarts and token
+ * rotation. See `docs/HUB.md` in the Workflow repository.
+ */
+export function resolveBridgeAuthority(): BridgeAuthority | undefined {
+	const url = process.env.WORKFLOW_CLINE_BRIDGE_URL?.trim();
+	const token = process.env.WORKFLOW_CLINE_BRIDGE_TOKEN?.trim();
+	if (url && token) return { url, token };
+	try {
+		const discovery = JSON.parse(
+			readFileSync(join(homedir(), ".workflow", "hub", "discovery.json"), "utf8"),
+		) as { endpoint?: unknown; token?: unknown };
+		if (typeof discovery.endpoint === "string" && typeof discovery.token === "string") {
+			return { url: discovery.endpoint, token: discovery.token };
+		}
+	} catch {
+		// No discovery file (or unreadable): fall through to fail closed.
+	}
+	return undefined;
+}
+
+/**
+ * Workflow authorization hooks for sessions started inside the hub daemon
+ * (scheduled agents, chat connectors, teams). Every `beforeTool` decision is
+ * delegated to the Workflow authority over its loopback bridge and fails
+ * closed when the authority is unavailable. See `docs/HUB.md` in the Workflow
+ * repository.
+ */
+export function createWorkflowHubHooks(runId?: string): AgentHooks {
+	return {
+		beforeTool: async (ctx) => {
+			const authority = resolveBridgeAuthority();
+			if (!authority) {
+				return {
+					stop: true,
+					reason:
+						"Workflow authorization unavailable: WORKFLOW_CLINE_BRIDGE_URL/WORKFLOW_CLINE_BRIDGE_TOKEN are not configured and no hub discovery file exists",
+				};
+			}
+			const { url, token } = authority;
+			try {
+				const response = await fetch(`${url}/before-tool`, {
+					method: "POST",
+					headers: {
+						authorization: `Bearer ${token}`,
+						"content-type": "application/json",
+					},
+					body: JSON.stringify({
+					toolCall: ctx.toolCall,
+					input: ctx.input,
+					workspace: process.cwd(),
+					...(runId !== undefined ? { runId } : {}),
+				}),
+				});
+				const payload = (await response.json()) as BridgeResponse;
+				if (!response.ok) {
+					return {
+						stop: true,
+						reason: `Workflow authorization denied: ${payload.error || `bridge returned ${response.status}`}`,
+					};
+				}
+				if (payload.stop) {
+					return {
+						stop: true,
+						reason: payload.reason || "Workflow denied tool execution",
+					};
+				}
+				return undefined;
+			} catch (error) {
+				return {
+					stop: true,
+					reason: `Workflow authorization unavailable: ${error instanceof Error ? error.message : String(error)}`,
+				};
+			}
+		},
+	};
+}
