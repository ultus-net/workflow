@@ -0,0 +1,111 @@
+import { type AgentTool, createTool } from "@cline/shared";
+import { defaultMcpToolNameTransform } from "./name-transform";
+import type { CreateMcpToolsOptions, McpToolDescriptor } from "./types";
+
+const MAX_ENUMERATED_TOOLS = 50;
+const MAX_DESCRIPTION_CHARS = 120;
+
+/**
+ * Lazy MCP tool loading: instead of registering every server's full input
+ * schemas into the model's context (a fixed per-turn token tax that grows
+ * with every enabled server), expose two cheap meta-tools per server:
+ * - `discover_tools` enumerates names + one-line descriptions and returns
+ *   full schemas only for the tools the model actually asks about.
+ * - `call_tool` executes a discovered tool by name.
+ * Enable per server with `createMcpTools({ lazy: true })`.
+ */
+export async function createLazyMcpTools(
+	options: CreateMcpToolsOptions,
+): Promise<AgentTool[]> {
+	const descriptors = await options.provider.listTools(options.serverName);
+	const nameTransform = options.nameTransform ?? defaultMcpToolNameTransform;
+
+	const catalog = descriptors
+		.slice(0, MAX_ENUMERATED_TOOLS)
+		.map((descriptor) => {
+			const description = (descriptor.description?.trim() ?? "").slice(0, MAX_DESCRIPTION_CHARS);
+			return `- ${descriptor.name}${description.length > 0 ? `: ${description}` : ""}`;
+		})
+		.join("\n");
+	const omitted = descriptors.length - Math.min(descriptors.length, MAX_ENUMERATED_TOOLS);
+
+	const discoverName = nameTransform({ serverName: options.serverName, toolName: "discover_tools" });
+	const callName = nameTransform({ serverName: options.serverName, toolName: "call_tool" });
+
+	const discover = createTool({
+		name: discoverName,
+		description:
+			`List input schemas for MCP tools on server "${options.serverName}". ` +
+			`Call this first to learn a tool's schema, then invoke it via "${callName}". ` +
+			`Available tools:\n${catalog}${omitted > 0 ? `\n- …and ${omitted} more` : ""}`,
+		inputSchema: {
+			type: "object",
+			properties: {
+				toolNames: {
+					type: "array",
+					items: { type: "string" },
+					description: "Tools to return full input schemas for. Omit to list names only.",
+				},
+			},
+		},
+		timeoutMs: options.timeoutMs,
+		execute: async (input: unknown) => {
+			const requested = Array.isArray((input as { toolNames?: unknown })?.toolNames)
+				? ((input as { toolNames: unknown[] }).toolNames.filter((name): name is string => typeof name === "string"))
+				: [];
+			const selected = requested.length === 0
+				? []
+				: descriptors.filter((descriptor) => requested.includes(descriptor.name));
+			const payload = selected.length === 0
+				? { tools: catalog }
+				: {
+					schemas: selected.map((descriptor) => ({
+						name: descriptor.name,
+						description: descriptor.description,
+						inputSchema: descriptor.inputSchema,
+					})),
+				};
+			return { content: [{ type: "text", text: JSON.stringify(payload, null, 2) }] };
+		},
+	});
+
+	const call = createTool({
+		name: callName,
+		description:
+			`Execute an MCP tool on server "${options.serverName}" by name. ` +
+			`Use "${discoverName}" first to learn the tool's input schema.`,
+		inputSchema: {
+			type: "object",
+			properties: {
+				toolName: { type: "string", description: "Name of the MCP tool to execute." },
+				arguments: { type: "object", description: "Tool input payload." },
+			},
+			required: ["toolName"],
+		},
+		timeoutMs: options.timeoutMs,
+		retryable: options.retryable,
+		maxRetries: options.maxRetries,
+		execute: async (input: unknown, context) => {
+			const { toolName, arguments: toolArguments } = (input ?? {}) as {
+				toolName?: string;
+				arguments?: Record<string, unknown>;
+			};
+			if (typeof toolName !== "string" || toolName.length === 0) {
+				throw new TypeError("call_tool requires a toolName");
+			}
+			if (!descriptors.some((descriptor: McpToolDescriptor) => descriptor.name === toolName)) {
+				throw new Error(
+					`unknown MCP tool "${toolName}" on server "${options.serverName}"; call "${discoverName}" to list tools`,
+				);
+			}
+			return options.provider.callTool({
+				serverName: options.serverName,
+				toolName,
+				arguments: toolArguments,
+				context,
+			});
+		},
+	});
+
+	return [discover, call];
+}
