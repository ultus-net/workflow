index 0000000..f49678d
--- /dev/null
+++ b/sdk/packages/core/src/hub/daemon/workflow-runs.ts
@@ -0,0 +1,73 @@
+import { resolveBridgeAuthority } from "./workflow-hooks";
+
+/**
+ * Run lifecycle reporting to the Workflow hub: each hub-started scheduled
+ * session gets a dedicated task and evidence in the Workflow task graph.
+ * Lifecycle calls are advisory — authorization itself is enforced per tool
+ * call via `createWorkflowHubHooks` and remains fail-closed; a missed
+ * lifecycle report must not block session management. See
+ * `docs/HUB_PROTOCOL.md` §3 in the Workflow repository.
+ */
+async function runRequest(path: string, body: unknown): Promise<unknown | undefined> {
+	const authority = resolveBridgeAuthority();
+	if (!authority) return undefined;
+	try {
+		const response = await fetch(`${authority.url}${path}`, {
+			method: "POST",
+			headers: {
+				authorization: `Bearer ${authority.token}`,
+				"content-type": "application/json",
+			},
+			body: JSON.stringify(body),
+		});
+		if (!response.ok) return undefined;
+		return await response.json();
+	} catch {
+		return undefined;
+	}
+}
+
+export async function beginWorkflowRun(input: {
+	runId: string;
+	title: string;
+	workspace?: string;
+	requiresReview?: boolean;
+}): Promise<boolean> {
+	return (await runRequest("/run/begin", input)) !== undefined;
+}
+
+export async function finishWorkflowRun(input: {
+	runId: string;
+	outcome: "verified" | "failed";
+}): Promise<boolean> {
+	return (await runRequest("/run/finish", input)) !== undefined;
+}
+
+/**
+ * Fetches the hub's 5-axis review rubric for an orchestrator-spawned
+ * reviewer session. Advisory: returns undefined when the hub is
+ * unreachable or rejects the call.
+ */
+export async function fetchReviewRubric(input: {
+	diffText: string;
+	taskPrompt?: string;
+}): Promise<{ rubric: string } | undefined> {
+	const payload = (await runRequest("/review/rubric", input)) as { rubric?: unknown } | undefined;
+	return typeof payload?.rubric === "string" ? { rubric: payload.rubric } : undefined;
+}
+
+/**
+ * Records an independent reviewer session's verdict against an authoring
+ * run. Authoritative: the hub enforces cross-run and >=3-axis rules and
+ * reports whether reviewer evidence was recorded; the parsed result is
+ * returned to the caller (undefined only on transport failure).
+ */
+export async function submitWorkflowReview(input: {
+	runId: string;
+	reviewerRunId: string;
+	verdict: "approved" | "changes_requested" | "rejected";
+	summary: string;
+}): Promise<{ recorded: boolean } | undefined> {
+	const payload = (await runRequest("/run/review", input)) as { recorded?: unknown } | undefined;
+	return typeof payload?.recorded === "boolean" ? { recorded: payload.recorded } : undefined;
+}
