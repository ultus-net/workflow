+function loadWorkflowAnimation(path: string | undefined): { frames: string[]; frameRate?: number; delays?: number[]; width?: number; height?: number } | undefined {
+	try {
+		const decoded = path ? JSON.parse(readFileSync(path, "utf8")) : undefined;
+		const hasFrameRate = Number.isFinite(decoded?.frameRate) && decoded.frameRate > 0 && decoded.frameRate <= 60;
+		const hasDelays = Array.isArray(decoded?.delays) && decoded.delays.length === decoded.frames?.length &&
+			decoded.delays.every((delay: unknown) => Number.isFinite(delay) && Number(delay) >= 0 && Number(delay) <= 10_000);
+		const hasDimensions = Number.isInteger(decoded?.width) && decoded.width > 0 && decoded.width <= 300 &&
+			Number.isInteger(decoded?.height) && decoded.height > 0 && decoded.height <= 100;
+		if (
+			typeof decoded === "object" && decoded !== null &&
+			Array.isArray(decoded.frames) && decoded.frames.length > 0 && decoded.frames.length <= 120 &&
+			(hasFrameRate || hasDelays) &&
+			decoded.frames.every((frame: unknown) => validateWorkflowFrame(frame)) &&
+			(!hasDimensions || decoded.frames.every((frame: string) => validateWorkflowFrame(frame, decoded.width, decoded.height)))
+		) return { frames: decoded.frames, frameRate: hasFrameRate ? decoded.frameRate : undefined, delays: hasDelays ? decoded.delays : undefined, width: hasDimensions ? decoded.width : undefined, height: hasDimensions ? decoded.height : undefined };
+	} catch {
