+import { createServer, type Server } from "node:http";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import type { AddressInfo } from "node:net";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { createWorkflowBridge } from "./workflow-bridge";
+
+describe("createWorkflowBridge authority resolution", () => {
+	let server: Server | undefined;
+	let home: string;
+	let originalHome: string | undefined;
+	let bridgeUrl: string;
+
+	beforeEach(async () => {
+		originalHome = process.env.HOME;
+		home = mkdtempSync(join(tmpdir(), "workflow-bridge-home-"));
+		process.env.HOME = home;
+		server = createServer((request, response) => {
+			const chunks: Buffer[] = [];
+			request.on("data", (chunk) => chunks.push(chunk));
+			request.on("end", () => {
+				if (request.headers.authorization !== "Bearer test-token") {
+					response.writeHead(401, { "content-type": "application/json" });
+					response.end(JSON.stringify({ error: "unauthorized" }));
+					return;
+				}
+				response.writeHead(200, { "content-type": "application/json" });
+				response.end(JSON.stringify({}));
+			});
+		});
+		await new Promise<void>((resolve) => server!.listen(0, "127.0.0.1", resolve));
+		bridgeUrl = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
+	});
+
+	afterEach(async () => {
+		delete process.env.WORKFLOW_CLINE_BRIDGE_URL;
+		delete process.env.WORKFLOW_CLINE_BRIDGE_TOKEN;
+		if (originalHome === undefined) delete process.env.HOME;
+		else process.env.HOME = originalHome;
+		rmSync(home, { recursive: true, force: true });
+		await new Promise<void>((resolve) => server?.close(() => resolve()));
+		server = undefined;
+	});
+
+	it("prefers the launcher-provided environment", async () => {
+		process.env.WORKFLOW_CLINE_BRIDGE_URL = bridgeUrl;
+		process.env.WORKFLOW_CLINE_BRIDGE_TOKEN = "test-token";
+		const bridge = createWorkflowBridge();
+		const decision = await bridge.authorize(undefined).beforeTool?.({
+			toolCall: { toolName: "read_file" },
+			input: {},
+		} as never);
+		expect(decision?.stop).toBeFalsy();
+	});
+
+	it("falls back to the Workflow hub discovery file", async () => {
+		const discoveryDir = join(home, ".workflow", "hub");
+		mkdirSync(discoveryDir, { recursive: true });
+		writeFileSync(
+			join(discoveryDir, "discovery.json"),
+			JSON.stringify({ hubId: "hub-1", endpoint: bridgeUrl, token: "test-token" }),
+		);
+		const bridge = createWorkflowBridge();
+		const decision = await bridge.authorize(undefined).beforeTool?.({
+			toolCall: { toolName: "read_file" },
+			input: {},
+		} as never);
+		expect(decision?.stop).toBeFalsy();
+	});
+
+	it("throws when neither the environment nor a discovery file is available", () => {
+		expect(() => createWorkflowBridge()).toThrow(/Workflow authorization bridge/);
+	});
+});
diff --git a/apps/cli/src/utils/workflow-bridge.ts b/apps/cli/src/utils/workflow-bridge.ts
new file mode 100644
index 0000000..4656b2e
--- /dev/null
+++ b/apps/cli/src/utils/workflow-bridge.ts
@@ -0,0 +1,88 @@
+import type { AgentHooks, ShellExecutor } from "@cline/core";
+import { readFileSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+type BridgeResponse = {
+	stop?: boolean;
+	reason?: string;
+	output?: string;
+	error?: string;
+};
+
+/**
+ * Resolves the Workflow authority: launcher-provided environment first, then
+ * the global Workflow hub's discovery file. See `docs/HUB.md` in the Workflow
+ * repository.
+ */
+function resolveBridgeAuthority(): { url: string; token: string } {
+	const url = process.env.WORKFLOW_CLINE_BRIDGE_URL?.trim();
+	const token = process.env.WORKFLOW_CLINE_BRIDGE_TOKEN?.trim();
+	if (url && token) return { url, token };
+	try {
+		const discovery = JSON.parse(
+			readFileSync(join(homedir(), ".workflow", "hub", "discovery.json"), "utf8"),
+		) as { endpoint?: unknown; token?: unknown };
+		if (typeof discovery.endpoint === "string" && typeof discovery.token === "string") {
+			return { url: discovery.endpoint, token: discovery.token };
+		}
+	} catch {
+		// No discovery file (or unreadable): fall through to fail closed.
+	}
+	throw new Error("Workflow authorization bridge is required for this Cline build");
+}
+
+export function createWorkflowBridge() {
+	const { url, token } = resolveBridgeAuthority();
+
+	const request = async (path: string, body: unknown): Promise<BridgeResponse> => {
+		const response = await fetch(`${url}${path}`, {
+			method: "POST",
+			headers: {
+				authorization: `Bearer ${token}`,
+				"content-type": "application/json",
+			},
+			body: JSON.stringify(body),
+		});
+		const payload = (await response.json()) as BridgeResponse;
+		if (!response.ok) {
+			throw new Error(payload.error || `Workflow bridge returned ${response.status}`);
+		}
+		return payload;
+	};
+
+	const authorize = (hooks: AgentHooks | undefined): AgentHooks => ({
+		...hooks,
+		beforeTool: async (ctx) => {
+			try {
+				const decision = await request("/before-tool", {
+					toolCall: ctx.toolCall,
+					input: ctx.input,
+					workspace: process.cwd(),
+				});
+				if (decision.stop) {
+					return {
+						stop: true,
+						reason: decision.reason || "Workflow denied tool execution",
+					};
+				}
+			} catch (error) {
+				return {
+					stop: true,
+					reason: `Workflow authorization unavailable: ${error instanceof Error ? error.message : String(error)}`,
+				};
+			}
+			return await hooks?.beforeTool?.(ctx);
+		},
+	});
+
+	const bash: ShellExecutor = async (command, cwd) => {
+		const result = await request("/bash", { command, cwd });
+		if (typeof result.output !== "string") {
+			throw new Error(result.error || "Workflow bash executor returned no output");
+		}
+		return result.output;
+	};
+
+	return { authorize, bash };
+}
