+export function resolveCwdArg(argv: string[]): string | undefined {
+	for (let i = 0; i < argv.length; i++) {
+		const arg = argv[i];
+		if (arg === "--cwd" || arg === "-c") {
+			const value = argv[i + 1]?.trim();
+			return value ? value : undefined;
+		}
+		if (arg?.startsWith("--cwd=")) {
+			const value = arg.slice("--cwd=".length).trim();
+			return value ? value : undefined;
+		}
+		if (arg?.startsWith("-c=")) {
+			const value = arg.slice("-c=".length).trim();
+			return value ? value : undefined;
+		}
+	}
+	return undefined;
+}
