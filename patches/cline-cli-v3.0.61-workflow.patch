+/**
+ * Middle-truncates oversized text payloads inside an MCP tool result using
+ * the same head/tail discipline as built-in command output. Unknown shapes
+ * pass through untouched.
+ */
+function truncateMcpResultContent(result: unknown): unknown {
+	if (typeof result !== "object" || result === null) return result;
+	const content = (result as { content?: unknown }).content;
+	if (!Array.isArray(content)) return result;
+	return {
+		...(result as Record<string, unknown>),
+		content: content.map((item) => {
+			if (typeof item !== "object" || item === null) return item;
+			const entry = item as Record<string, unknown>;
+			if (entry.type === "text" && typeof entry.text === "string") {
+				return { ...entry, text: truncateCommandOutput(entry.text) };
+			}
+			if (entry.type === "resource") {
+				const resource = entry.resource;
+				if (
+					typeof resource === "object" &&
+					resource !== null &&
+					typeof (resource as Record<string, unknown>).text === "string"
+				) {
+					return {
+						...entry,
+						resource: {
+							...(resource as Record<string, unknown>),
+							text: truncateCommandOutput((resource as Record<string, unknown>).text as string),
+						},
+					};
+				}
+			}
+			return item;
+		}),
+	};
+}
