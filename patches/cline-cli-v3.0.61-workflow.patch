@@ -0,0 +1,165 @@
+import type { AgentHooks, ShellExecutor } from "@cline/core";
+import { readFileSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+type BridgeResponse = {
+	stop?: boolean;
+	reason?: string;
+	output?: string;
+	error?: string;
+	snapshot?: WorkflowSnapshot;
+};
+
+type BeforeToolContext = Parameters<NonNullable<AgentHooks["beforeTool"]>>[0];
+type AfterToolContext = Parameters<NonNullable<AgentHooks["afterTool"]>>[0];
+type ShellCommand = Parameters<ShellExecutor>[0];
+type ShellCwd = Parameters<ShellExecutor>[1];
+
+export type WorkflowTaskProjection = {
+	id: string;
+	title: string;
+	state: string;
+	blockers: string[];
+};
+
+export type WorkflowSnapshot = {
+	tasks: WorkflowTaskProjection[];
+};
+
+export function createWorkflowSnapshotPoller(
+	snapshot: () => Promise<WorkflowSnapshot>,
+	onState: (state: { available: boolean; tasks: WorkflowTaskProjection[] }) => void,
+) {
+	let active = true;
+	let generation = 0;
+	const refresh = () => {
+		const requestGeneration = ++generation;
+		void snapshot().then(
+			(result) => {
+				if (active && requestGeneration === generation) {
+					onState({ available: true, tasks: result.tasks });
+				}
+			},
+			() => {
+				if (active && requestGeneration === generation) {
+					onState({ available: false, tasks: [] });
+				}
+			},
+		);
+	};
+	return { refresh, stop: () => { active = false; } };
+}
+
+/**
+ * Resolves the Workflow authority: launcher-provided environment first, then
+ * the global Workflow hub's discovery file. See `docs/HUB.md` in the Workflow
+ * repository.
+ */
+function resolveBridgeAuthority(): { url: string; token: string } {
+	const url = process.env.WORKFLOW_CLINE_BRIDGE_URL?.trim();
+	const token = process.env.WORKFLOW_CLINE_BRIDGE_TOKEN?.trim();
+	if (url && token) return { url, token };
+	try {
+		const discovery = JSON.parse(
+			readFileSync(join(homedir(), ".workflow", "hub", "discovery.json"), "utf8"),
+		) as { endpoint?: unknown; token?: unknown };
+		if (typeof discovery.endpoint === "string" && typeof discovery.token === "string") {
+			return { url: discovery.endpoint, token: discovery.token };
+		}
+	} catch {
+		// No discovery file (or unreadable): fall through to fail closed.
+	}
+	throw new Error("Workflow authorization bridge is required for this Cline build");
+}
+
+export function createWorkflowBridge() {
+	const { url, token } = resolveBridgeAuthority();
+	let activeTeamTaskId: string | undefined;
+
+	const request = async (path: string, body: unknown): Promise<BridgeResponse> => {
+		const response = await fetch(`${url}${path}`, {
+			method: "POST",
+			headers: {
+				authorization: `Bearer ${token}`,
+				"content-type": "application/json",
+			},
+			body: JSON.stringify(body),
+		});
+		const payload = (await response.json()) as BridgeResponse;
+		if (!response.ok) {
+			throw new Error(payload.error || `Workflow bridge returned ${response.status}`);
+		}
+		return payload;
+	};
+
+	const authorize = (hooks: AgentHooks | undefined): AgentHooks => ({
+		...hooks,
+		beforeTool: async (ctx: BeforeToolContext) => {
+			try {
+				const decision = await request("/before-tool", {
+					toolCall: ctx.toolCall,
+					input: ctx.input,
+					workspace: process.cwd(),
+				});
+				if (decision.stop) {
+					return {
+						skip: true,
+						reason: decision.reason || "Workflow denied tool execution",
+					};
+				}
+			} catch (error) {
+				return {
+					stop: true,
+					reason: `Workflow authorization unavailable: ${error instanceof Error ? error.message : String(error)}`,
+				};
+			}
+			return await hooks?.beforeTool?.(ctx);
+		},
+		afterTool: async (ctx: AfterToolContext) => {
+			if (ctx.toolCall.toolName === "team_task" && !ctx.result.isError) {
+				try {
+					for (let attempt = 0; ; attempt += 1) {
+						try {
+							await request("/team-task", {
+								input: ctx.input,
+								result: ctx.result.output,
+								workspace: process.cwd(),
+							});
+							const output = ctx.result.output as { action?: unknown; taskId?: unknown; status?: unknown };
+							if (
+								typeof output.taskId === "string" &&
+								(output.status === "in_progress" || output.action === "complete")
+							) activeTeamTaskId = output.taskId;
+							break;
+						} catch (error) {
+							if (attempt === 2) throw error;
+						}
+					}
+				} catch (error) {
+					return {
+						stop: true,
+						reason: `Workflow task synchronization failed: ${error instanceof Error ? error.message : String(error)}`,
+					};
+				}
+			}
+			return await hooks?.afterTool?.(ctx);
+		},
+	});
+
+	const bash: ShellExecutor = async (command: ShellCommand, cwd: ShellCwd) => {
+		const result = await request("/bash", { command, cwd, teamTaskId: activeTeamTaskId });
+		if (typeof result.output !== "string") {
+			throw new Error(result.error || "Workflow bash executor returned no output");
+		}
+		return result.output;
+	};
+
+	const snapshot = async (workspace?: string): Promise<WorkflowSnapshot> => {
+		const result = await request("/snapshot", { workspace });
+		if (!result.snapshot) throw new Error("Workflow bridge returned no snapshot");
+		return result.snapshot;
+	};
+
+	return { authorize, bash, snapshot };
+}
