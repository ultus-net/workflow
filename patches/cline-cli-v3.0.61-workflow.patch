+++ b/sdk/packages/core/src/hub/daemon/workflow-runs.test.ts
@@ -0,0 +1,139 @@
+import { createServer, type Server } from "node:http";
+import { mkdtempSync, rmSync } from "node:fs";
+import type { AddressInfo } from "node:net";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import {
+	beginWorkflowRun,
+	fetchReviewRubric,
+	finishWorkflowRun,
+	submitWorkflowReview,
+} from "./workflow-runs";
+
+describe("workflow run lifecycle", () => {
+	let server: Server | undefined;
+	let lastPath: string | undefined;
+	let lastBody: unknown;
+	let home: string;
+	let originalHome: string | undefined;
+	let status = 200;
+
+	beforeEach(async () => {
+		lastPath = undefined;
+		lastBody = undefined;
+		status = 200;
+		originalHome = process.env.HOME;
+		home = mkdtempSync(join(tmpdir(), "workflow-runs-home-"));
+		process.env.HOME = home;
+		server = createServer((request, response) => {
+			const chunks: Buffer[] = [];
+			request.on("data", (chunk) => chunks.push(chunk));
+			request.on("end", () => {
+				lastPath = request.url;
+				lastBody = JSON.parse(Buffer.concat(chunks).toString("utf8"));
+				response.writeHead(status, { "content-type": "application/json" });
+				if (status !== 200) {
+					response.end(JSON.stringify({ error: "boom" }));
+				} else if (lastPath === "/review/rubric") {
+					response.end(JSON.stringify({ rubric: "review axes: test integrity, ..." }));
+				} else if (lastPath === "/run/review") {
+					response.end(JSON.stringify({ recorded: true }));
+				} else {
+					response.end(JSON.stringify({}));
+				}
+			});
+		});
+		await new Promise<void>((resolve) => server!.listen(0, "127.0.0.1", resolve));
+		const { port } = server.address() as AddressInfo;
+		process.env.WORKFLOW_CLINE_BRIDGE_URL = `http://127.0.0.1:${port}`;
+		process.env.WORKFLOW_CLINE_BRIDGE_TOKEN = "test-token";
+	});
+
+	afterEach(async () => {
+		delete process.env.WORKFLOW_CLINE_BRIDGE_URL;
+		delete process.env.WORKFLOW_CLINE_BRIDGE_TOKEN;
+		if (originalHome === undefined) delete process.env.HOME;
+		else process.env.HOME = originalHome;
+		rmSync(home, { recursive: true, force: true });
+		await new Promise<void>((resolve) => server?.close(() => resolve()));
+		server = undefined;
+	});
+
+	it("begins a run against the Workflow hub", async () => {
+		const ok = await beginWorkflowRun({ runId: "cron-1", title: "Nightly audit", workspace: "/repo" });
+		expect(ok).toBe(true);
+		expect(lastPath).toBe("/run/begin");
+		expect(lastBody).toEqual({ runId: "cron-1", title: "Nightly audit", workspace: "/repo" });
+	});
+
+	it("finishes a run against the Workflow hub", async () => {
+		const ok = await finishWorkflowRun({ runId: "cron-1", outcome: "verified" });
+		expect(ok).toBe(true);
+		expect(lastPath).toBe("/run/finish");
+		expect(lastBody).toEqual({ runId: "cron-1", outcome: "verified" });
+	});
+
+	it("threads requiresReview through run begin", async () => {
+		const ok = await beginWorkflowRun({ runId: "cron-2", title: "Authoring run", requiresReview: true });
+		expect(ok).toBe(true);
+		expect(lastPath).toBe("/run/begin");
+		expect(lastBody).toEqual({ runId: "cron-2", title: "Authoring run", requiresReview: true });
+	});
+
+	it("fetches the 5-axis review rubric (advisory)", async () => {
+		const result = await fetchReviewRubric({ diffText: "diff --git a/x b/x", taskPrompt: "ctx" });
+		expect(result).toEqual({ rubric: "review axes: test integrity, ..." });
+		expect(lastPath).toBe("/review/rubric");
+		expect(lastBody).toEqual({ diffText: "diff --git a/x b/x", taskPrompt: "ctx" });
+	});
+
+	it("returns undefined when the rubric fetch fails", async () => {
+		status = 500;
+		expect(await fetchReviewRubric({ diffText: "d" })).toBeUndefined();
+		delete process.env.WORKFLOW_CLINE_BRIDGE_URL;
+		delete process.env.WORKFLOW_CLINE_BRIDGE_TOKEN;
+		expect(await fetchReviewRubric({ diffText: "d" })).toBeUndefined();
+	});
+
+	it("submits a cross-run review verdict and returns the recorded result", async () => {
+		const result = await submitWorkflowReview({
+			runId: "schedule:author",
+			reviewerRunId: "schedule:reviewer",
+			verdict: "approved",
+			summary: "test integrity, task completeness, security checked",
+		});
+		expect(result).toEqual({ recorded: true });
+		expect(lastPath).toBe("/run/review");
+		expect(lastBody).toEqual({
+			runId: "schedule:author",
+			reviewerRunId: "schedule:reviewer",
+			verdict: "approved",
+			summary: "test integrity, task completeness, security checked",
+		});
+	});
+
+	it("returns undefined when the review submission fails", async () => {
+		status = 500;
+		expect(
+			await submitWorkflowReview({
+				runId: "schedule:author",
+				reviewerRunId: "schedule:reviewer",
+				verdict: "rejected",
+				summary: "s",
+			}),
+		).toBeUndefined();
+	});
+
+	it("is advisory when the hub rejects the lifecycle call", async () => {
+		status = 500;
+		expect(await beginWorkflowRun({ runId: "cron-1", title: "t" })).toBe(false);
+		expect(await finishWorkflowRun({ runId: "cron-1", outcome: "failed" })).toBe(false);
+	});
+
+	it("is advisory when no hub authority is resolvable", async () => {
+		delete process.env.WORKFLOW_CLINE_BRIDGE_URL;
+		delete process.env.WORKFLOW_CLINE_BRIDGE_TOKEN;
+		expect(await beginWorkflowRun({ runId: "cron-1", title: "t" })).toBe(false);
+	});
+});
diff --git a/sdk/packages/core/src/hub/daemon/workflow-runs.ts b/sdk/packages/core/src/hub/daemon/workflow-runs.ts
