+import { describe, expect, it, vi } from "vitest";
+import { createLazyMcpTools, createMcpTools } from "./index";
+import type { McpToolDescriptor, McpToolProvider } from "./types";
+
+const descriptors: readonly McpToolDescriptor[] = [
+	{
+		name: "search_memory",
+		description: "Search durable project memory with a bounded result set and a fairly long description that costs context tokens.",
+		inputSchema: {
+			type: "object",
+			properties: {
+				workspaceRoot: { type: "string", description: "Absolute workspace root" },
+				query: { type: "string" },
+				limit: { type: "number" },
+			},
+			required: ["workspaceRoot", "query"],
+		},
+	},
+	{
+		name: "record_memory",
+		description: "Record a durable fact, decision, constraint, or lesson for future sessions.",
+		inputSchema: { type: "object", properties: { content: { type: "string" } }, required: ["content"] },
+	},
+];
+
+function provider(result: unknown = { ok: true }): McpToolProvider {
+	return {
+		listTools: vi.fn(async () => descriptors),
+		callTool: vi.fn(async () => result),
+	};
+}
+
+describe("createLazyMcpTools", () => {
+	it("exposes cheap meta-tools instead of full tool schemas", async () => {
+		const tools = await createLazyMcpTools({ serverName: "memory", provider: provider() });
+		expect(tools).toHaveLength(2);
+		const [discover, call] = tools;
+		expect(discover!.name).toContain("discover");
+		expect(call!.name).toContain("call");
+		// The discovery tool description enumerates names+descriptions but no schemas.
+		expect(discover!.description).toContain("search_memory");
+		expect(discover!.description).toContain("record_memory");
+		expect(discover!.description).not.toContain("workspaceRoot");
+		// The full schemas do not enter the model's tool list.
+		expect(JSON.stringify(tools.map((t) => t.inputSchema))).not.toContain("workspaceRoot");
+	});
+
+	it("returns full input schemas on demand via the discover tool", async () => {
+		const [discover] = await createLazyMcpTools({ serverName: "memory", provider: provider() });
+		const result = (await discover!.execute(
+			{ toolNames: ["search_memory"] },
+			{} as never,
+		)) as { content: Array<{ text: string }> };
+		expect(result.content[0]!.text).toContain("workspaceRoot");
+		expect(result.content[0]!.text).not.toContain("record_memory");
+	});
+
+	it("routes calls through the provider by tool name", async () => {
+		const client = provider({ content: [{ type: "text", text: "found" }] });
+		const [, call] = await createLazyMcpTools({ serverName: "memory", provider: client });
+		const result = await call!.execute(
+			{ toolName: "search_memory", arguments: { query: "atomic" } },
+			{} as never,
+		);
+		expect(client.callTool).toHaveBeenCalledWith({
+			serverName: "memory",
+			toolName: "search_memory",
+			arguments: { query: "atomic" },
+			context: {},
+		});
+		expect(result).toEqual({ content: [{ type: "text", text: "found" }] });
+	});
+});
+
+describe("createMcpTools lazy mode", () => {
+	it("returns only the meta-tools when lazy is enabled", async () => {
+		const tools = await createMcpTools({ serverName: "memory", provider: provider(), lazy: true });
+		expect(tools).toHaveLength(2);
+		const eager = await createMcpTools({ serverName: "memory", provider: provider() });
+		expect(eager).toHaveLength(2);
+		expect(JSON.stringify(eager.map((t) => t.inputSchema))).toContain("workspaceRoot");
+	});
+});
