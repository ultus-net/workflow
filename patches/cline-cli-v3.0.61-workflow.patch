@@ -0,0 +1,10 @@
+import { createWorkflowBridge } from "./workflow-bridge";
+
+/**
+ * Every hub-side session creator (zen, schedule, connectors) must attach the
+ * Workflow authorization bridge as a localRuntime hook; the hub executes
+ * these client-side hooks through its contribution RPC.
+ */
+export function workflowBridgeLocalRuntime(): { localRuntime: { hooks: import("@cline/core").AgentHooks } } {
+	return { localRuntime: { hooks: createWorkflowBridge().authorize(undefined) } };
+}
