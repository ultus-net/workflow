+export function WorkflowTaskList({ workspace }: { workspace?: string }) {
+	const [tasks, setTasks] = useState<WorkflowTaskProjection[]>([]);
+	const [available, setAvailable] = useState<boolean | null>(null);
+	const [expanded, setExpanded] = useState(true);
+
+	useEffect(() => {
+		try {
+			const workflow = createWorkflowBridge();
+			const poller = createWorkflowSnapshotPoller(
+				() => workflow.snapshot(workspace),
+				(state) => {
+					setTasks(state.tasks);
+					setAvailable(state.available);
+				},
+			);
+			poller.refresh();
+			const interval = setInterval(poller.refresh, 2_000);
+			return () => {
+				poller.stop();
+				clearInterval(interval);
+			};
+		} catch {
+			setAvailable(false);
+			return undefined;
+		}
+	}, [workspace]);
+	if (available !== true || tasks.length === 0) return null;
+	const activeTask = tasks.find((task) => task.state === "IN_PROGRESS");
+	const visible = activeTask && !tasks.slice(0, 6).includes(activeTask)
+		? [...tasks.slice(0, 5), activeTask]
+		: tasks.slice(0, 6);
+	const verified = tasks.filter((task) => task.state === "VERIFIED").length;
+
+	return (
+		<box flexDirection="column" marginBottom={1}>
+			<box onMouseDown={() => setExpanded(!expanded)}>
+				<text fg="gray">{`${expanded ? "v" : ">"} Workflow tasks ${verified}/${tasks.length} verified`}</text>
+			</box>
+			{expanded ? (
+				<>
+					<text> </text>
+					{visible.map((task) => (
+						<text key={task.id}>
+							{`  ${task.state === "IN_PROGRESS" ? ">" : "-"} ${task.title} [${task.state}]${task.blockers.length > 0 ? ` blocked by ${task.blockers.join(", ")}` : ""}`}
+						</text>
+					))}
+					{tasks.length > visible.length ? <text fg="gray">{`  ... ${tasks.length - visible.length} more`}</text> : null}
+				</>
+			) : null}
+		</box>
+	);
+}
