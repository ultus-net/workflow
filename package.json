{
  "name": "workflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "workflow": "dist/cli/tui.js",
    "workflow-hub": "dist/cli/hub.js",
    "workflow-monitor": "dist/cli/ink-tui.js",
    "workflow-shell": "dist/cli/contained-shell.js",
    "workflow-pets": "dist/cli/pets.js"
  },
  "postinstall": "node scripts/prepare-tool.mjs",
  "files": [
    "dist",
    "README.md",
    "THREAT_MODEL.md",
    "docs",
    "mcp-toolbox",
    "packaging"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "tui": "node scripts/build-cline-tui.mjs && tsx src/cli/tui.tsx",
    "tui:workflow": "tsx src/cli/ink-tui.tsx",
    "style:eval": "tsx src/cli/style-eval.ts",
    "motion:examples": "tsx src/cli/motion-examples.ts",
    "motion:import": "tsx src/cli/motion-import.ts",
    "pets": "tsx src/cli/pets.ts",
    "tui:cline:build": "node scripts/build-cline-tui.mjs",
    "cline:bump": "node scripts/bump-cline-tag.mjs",
    "contained-shell": "tsx src/cli/contained-shell.ts",
    "web": "tsx src/cli/web.ts",
    "pretest": "node scripts/build-cline-tui.mjs",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:cline-runtime": "npm run build && node test/integration/cline-runtime.mjs",
    "test:cline-coding-session": "npm run build && node test/integration/cline-coding-session.mjs",
    "test:cline-resume": "npm run build && node test/integration/cline-resume.mjs",
    "test:containment-runtime": "node --import tsx --test test/containment.test.ts",
    "test:e2e": "npm run build && node test/integration/workflow-e2e.mjs",
    "toolbox:install": "pnpm --dir mcp-toolbox install",
    "toolbox:build": "pnpm --dir mcp-toolbox run build",
    "toolbox:verify": "pnpm --dir mcp-toolbox run verify",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "eslint": "^10.10.0",
    "ink-testing-library": "^4.0.0",
    "node-pty": "^1.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "gifuct-js": "^2.1.2",
    "ink": "^7.1.1",
    "react": "^19.2.0"
  }
}
